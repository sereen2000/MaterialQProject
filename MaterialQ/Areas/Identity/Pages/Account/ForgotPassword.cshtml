@page
@model ForgotPasswordModel

@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    @* <img src="~/img/LOGO_page.png" alt=""> *@
    <title>Login | Art Of Quote </title>

    <!-- Bootstrap -->
    <link href="~/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: url('/img/Image.png') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center; /* أفقياً */
            align-items: center; /* عمودياً */
        }

        .login-wrapper {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 20px;
            padding: 40px 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            backdrop-filter: blur(5px);
            max-width: 550px;
            width: 100%;
        }

        .logo img {
            max-height: 50px;
            margin-right: 8px;
        }

        .logo span {
            font-size: 22px;
            font-weight: 600;
            color: #3e3e3e;
        }

        .card {
            background-color: #ffffffcc;
            border: none;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 15px;
        }

        card-body {
            text-align: left;
            display: block;
        }

        .btn-primary {
            background-color: #b89c6b;
            border: none;
            font-weight: 600;
        }

            .btn-primary:hover {
                background-color: #a38552;
            }

        a {
            color: #b89c6b;
        }

            a:hover {
                text-decoration: underline;
            }

        h5.card-title {
            color: #2e2e2e;
            font-weight: 600;
        }

        .form-label {
            color: #444;
            font-weight: 500;
            text-align: left;
            display: block;
        }

        .form-check {
            text-align: left;
            display: block;
        }
    </style>
</head>

