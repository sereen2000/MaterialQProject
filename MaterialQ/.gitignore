## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio 2019/2022
.vs/

# Rider
.idea/

# Visual Studio Code
.vscode/

# Logs
*.log

# Local database files
*.mdf
*.ldf
*.db

# Others
publish/
appsettings.Production.json
secrets.json
