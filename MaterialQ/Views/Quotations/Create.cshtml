@model MaterialQ.Models.ViewModels.AddQuotationViewModel

@{
    ViewData["Title"] = "Add Quotation";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-plus-circle me-2"></i> Select Items</h2>

        <a asp-controller="Quotations" asp-action="ReviewQuotation" class="btn btn-outline-secondary position-relative">
            <i class="bi bi-cart3"></i> Cart
            <span id="cartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                0
            </span>
        </a>
    </div>

   <form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" class="form-control" name="search" 
               placeholder="Search items..."
               value="@ViewBag.Search" />
    </div>

    <div class="col-md-2 d-grid">
        <button class="btn btn-outline-primary" type="submit">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
</form>


    <!-- جدول العناصر -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Unit</th>
                        <th>Unit Price</th>
                        <th>Vat</th>
                        <th style="width: 100px;">Color</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Description</td>
                                <td>@item.Unit?.Name</td>
                                <td>@item.Price.ToString("F2")</td>
                                <td>@item.Vat</td>
                                <td>
                                    <select class="form-select form-select-sm color-select">
                                        <option value="">Select color</option>
                                        @foreach (var c in item.ColorItems)
                                        {
                                            <option value="@c.ColorId"
                                                    data-color-name="@c.Color?.Name"
                                                    data-stock="@c.Quantity">
                                                @c.Color?.Name (@c.Quantity)
                                            </option>
                                        }

                                    </select>
                                </td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-success"
                                            onclick="addToCart('@item.Id', this)">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </td>
                            </tr>

                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No items found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
            function addToCart(id, btn) {

            let cart = JSON.parse(localStorage.getItem("cart")) || [];

            const row = btn.closest("tr");

            const code = row.children[0].innerText.trim();
            const description = row.children[1].innerText.trim();
            const unit = row.children[2].innerText.trim();
            const price = parseFloat(row.children[3].innerText.trim()) || 0;
            const vat = parseFloat(row.children[4].innerText.trim()) || 0;

            const colorSelect = row.querySelector(".color-select");
            const selectedOption = colorSelect.options[colorSelect.selectedIndex];

            if (!selectedOption.value) {
                alert("⚠ Please select color first");
                return;
            }

            const colorId = selectedOption.value;
            const colorName = selectedOption.dataset.colorName;
            const stock = parseInt(selectedOption.dataset.stock) || 0;

            if (stock <= 0) {
                alert("❌ This color is out of stock");
                return;
            }

            const existing = cart.find(x => x.id === id && x.colorId === colorId);

            if (existing) {
                if (existing.qty + 1 > stock) {
                    alert("❌ Quantity exceeds available stock");
                    return;
                }
                existing.qty++;
            } else {
                cart.push({
                    id: id,
                    code: code,
                    itemDescription: description,
                    unit: unit,
                    price: price,
                    vat: vat,
                    colorId: colorId,
                    colorName: colorName,
                    stock: stock,
                    qty: 1
                });
            }

            localStorage.setItem("cart", JSON.stringify(cart));
            document.getElementById("cartCount").innerText = cart.length;
        }


        document.addEventListener("DOMContentLoaded", () => {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            document.getElementById("cartCount").innerText = cart.length;
        });
    </script>
}

