@model MaterialQ.Models.DataModels.QuotationModel

@{
    ViewData["Title"] = "Edit Quotation";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-pencil-square me-2"></i> Edit Quotation</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <!-- Quotation Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Quotation Information</h5>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label fw-bold">Customer Name</label>
                <div class="col-sm-9">
                    <input type="text" id="customerName" class="form-control"
                           value="@Model.CustomerName" required />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-3 col-form-label fw-bold">Discount (%)</label>
                <div class="col-sm-9">
                    <input type="number" id="discount" class="form-control"
                           value="@Model.Discount" min="0" max="100" />
                </div>
            </div>

        </div>
    </div>

    <!-- Items -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">Quotation Items</h5>

            @if (Model.Items != null && Model.Items.Any())
            {
                <table class="table table-hover align-middle" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Item ID</th>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>VAT</th>
                            <th>Discount (%)</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr data-id="@item.ItemId">

                                <td>@item.ItemId</td>

                                <!-- Description: READ ONLY -->
                                <td>
                                    <input type="text" class="form-control desc"
                                           value="@item.ItemDescription" readonly />
                                </td>

                                <!-- Quantity: EDITABLE -->
                                <td>
                                    <input type="number" class="form-control qty"
                                           value="@item.Quantity" min="1" />
                                </td>

                                <!-- Unit Price: READ ONLY -->
                                <td>
                                    <input type="number" class="form-control price"
                                           value="@item.UnitPrice" step="0.01" readonly />
                                </td>

                                <!-- VAT: READ ONLY -->
                                <td>
                                    <input type="number" class="form-control vat"
                                           value="@item.Vat" step="0.01" readonly />
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control discount"
                                           value="@item.Discount"
                                           min="0"
                                           max="100"
                                           step="0.01" />
                                </td>

                                <td class="total-cell fw-bold"></td>

                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center py-3">No items found for this quotation.</p>
            }

            <div class="d-flex justify-content-end mt-3">
                <div class="text-end">
                    <h6>Total Amount: <span id="subtotal" class="fw-bold text-primary"></span> JOD</h6>
                    <h6>Discount Amount : <span id="discountVal" class="fw-bold"></span> JOD</h6>
                    <h5 class="text-success">Net Amount: <span id="netAmount" class="fw-bold"></span> JOD</h5>
                </div>
                @* <div class="text-end">
                    <h6>Total Amount: <span class="fw-bold">@Model.TotalAmount.ToString("F2") JOD</span></h6>
                    <h6>Discount: <span class="fw-bold">@Model.Discount.ToString("F2") %</span></h6>
                    <h5 class="text-success">Net Amount: <span class="fw-bold">@Model.NetAmount.ToString("F2") JOD</span></h5>
                </div> *@
            </div>

        </div>
    </div>

    <div class="text-end mt-4">
        <button class="btn btn-success px-4" onclick="saveChanges(@Model.Id)">
            <i class="bi bi-check-circle"></i> Save Changes
        </button>
    </div>

</div>

@section Scripts {
    <script>

        function recalcTotals() {
            let subtotal = 0;

            document.querySelectorAll("#itemsTable tbody tr").forEach(row => {
                       const qty = parseFloat(row.querySelector(".qty").value) || 0;
        const price = parseFloat(row.querySelector(".price").value) || 0;
        const vat = parseFloat(row.querySelector(".vat").value) || 0;
        const discount = parseFloat(row.querySelector(".discount").value) || 0;

        const base = qty * price;
        const discountAmount = base * (discount / 100);
        const total = base - discountAmount + vat;

                
                row.querySelector(".total-cell").innerText = total.toFixed(2);

                subtotal += total;
            });

            document.getElementById("subtotal").innerText = subtotal.toFixed(2);

            const discount = parseFloat(document.getElementById("discount").value) || 0;
            const discountAmount = subtotal * (discount / 100);

            document.getElementById("discountVal").innerText = discountAmount.toFixed(2);
            document.getElementById("netAmount").innerText = (subtotal - discountAmount).toFixed(2);
        }

        document.addEventListener("input", recalcTotals);
        document.addEventListener("DOMContentLoaded", recalcTotals);

             async function saveChanges(id) {

            let items = [];

            document.querySelectorAll("#itemsTable tbody tr").forEach(row => {
                    items.push({
            ItemId: row.dataset.id,
            ItemDescription: row.querySelector(".desc").value,
            Quantity: parseInt(row.querySelector(".qty").value),
            UnitPrice: parseFloat(row.querySelector(".price").value),
            Vat: parseFloat(row.querySelector(".vat").value),
            Discount: parseFloat(row.querySelector(".discount").value) || 0
        });

            });

            const quotation = {
                Id: id,
                CustomerName: document.getElementById("customerName").value,
                Discount: parseFloat(document.getElementById("discount").value),
                TotalAmount: parseFloat(document.getElementById("subtotal").innerText),
                NetAmount: parseFloat(document.getElementById("netAmount").innerText),
                Items: items
            };

            const res = await fetch('/Quotations/UpdateQuotation', {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(quotation)
            });

            const data = await res.json();

            if (data.success)
                window.location.href = "/Quotations/Index";
            else
                alert(data.message ?? "Error while saving");
        }

    </script>
}
