@model IEnumerable<MaterialQ.Models.DataModels.QuotationModel>

@{
    ViewData["Title"] = "Quotations";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-3">Quotations</h2>

    <form method="get" class="row g-3 mb-4">

        <div class="col-md-3">
            <label class="form-label">From Date</label>
            <input type="date"
                   name="from"
                   class="form-control"
                   value="@(Context.Request.Query["from"])" />
        </div>

        <div class="col-md-3">
            <label class="form-label">To Date</label>
            <input type="date"
                   name="to"
                   class="form-control"
                   value="@(Context.Request.Query["to"])" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Search by customer or quotation number"
                   value="@(Context.Request.Query["search"])" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

    </form>

    <!-- 📄 Quotations Table -->
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Quotation No</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Net Amount</th>
                <th class="text-center" style="width:260px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@q.Id</td>
                    <td>@q.QuotationNumber</td>
                    <td>@q.Company?.Name</td>
                    <td>@q.DateCreated.ToString("dd/MM/yyyy")</td>
                    <td>@q.TotalAmount</td>
                    <td>@q.NetAmount</td>

                    <td class="text-center">
                        <a asp-action="Details"
                           asp-route-id="@q.Id"
                           class="btn btn-sm btn-info me-1">
                            <i class="bi bi-eye"></i>
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@q.Id"
                           class="btn btn-sm btn-primary me-1">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <a asp-action="ExportToPdf"
                           asp-route-id="@q.Id"
                           class="btn btn-sm btn-warning me-1">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </a>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="deleteQuotation(@q.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

@section Scripts {
    <script>
        async function deleteQuotation(id) {
            if (!confirm("Are you sure you want to delete this quotation?")) return;

            await fetch(`/Quotations/Delete/${id}`, { method: "POST" });
            location.reload();
        }
    </script>
}
