@model IEnumerable<MaterialQ.Models.DataModels.QuotationModel>

@{
    ViewData["Title"] = "Quotations";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-receipt me-2"></i> Quotations List</h2>

        <a asp-controller="Quotations" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Quotation
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Quotation Number</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model)
                        {
                            <tr>
                                <td>@q.Id</td>
                                <td>@q.QuotationNumber</td>
                                <td>@q.CustomerName</td>
                                <td>@q.DateCreated.ToString("yyyy-MM-dd")</td>
                                <td>@q.NetAmount.ToString("F2") JOD</td>
                                <td>
                                    @if (q.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (q.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@q.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Quotations" asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Quotations" asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteQuotation(@q.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-clipboard-x" style="font-size: 2rem;"></i>
                    <p class="mt-3">No quotations found.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function deleteQuotation(id) {
            if (!confirm("Are you sure you want to delete this quotation?")) return;

            const res = await fetch(`/Quotations/Delete/${id}`, { method: "POST" });
            if (res.ok) {
                alert("Quotation deleted successfully.");
                location.reload();
            } else {
                alert("Failed to delete quotation.");
            }
        }
    </script>
}
