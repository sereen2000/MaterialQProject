@model IEnumerable<MaterialQ.Models.DataModels.QuotationModel>

@{
    ViewData["Title"] = "Quotations";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-3">Quotations</h2>

    <!-- 🔍 Filter Form -->
    <form method="get" class="row g-3 mb-4">

        <div class="col-md-3">
            <label class="form-label">From Date</label>
            <input type="date" name="from" class="form-control"
                   value="@(Context.Request.Query["from"])" />
        </div>

        <div class="col-md-3">
            <label class="form-label">To Date</label>
            <input type="date" name="to" class="form-control"
                   value="@(Context.Request.Query["to"])" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>

                <option value="Draft"
                        selected="@(Context.Request.Query["status"] == "Draft")">
                    Draft
                </option>

                <option value="Approved"
                        selected="@(Context.Request.Query["status"] == "Approved")">
                    Approved
                </option>

                <option value="Rejected"
                        selected="@(Context.Request.Query["status"] == "Rejected")">
                    Rejected
                </option>
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Filter
            </button>
        </div>
    </form>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Quotation No</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th style="width:240px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@q.Id</td>
                    <td>@q.QuotationNumber</td>
                    <td>@q.CustomerName</td>
                    <td>@q.DateCreated.ToString("dd/MM/yyyy")</td>
                    <td>@q.TotalAmount</td>
                    <td>@q.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@q.Id"
                           class="btn btn-sm btn-info me-1">
                            <i class="bi bi-eye"></i> View
                        </a>

                        <a asp-action="Edit" asp-route-id="@q.Id"
                           class="btn btn-sm btn-primary me-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>


                        <button class="btn btn-sm btn-danger"
                                onclick="deleteQuotation(@q.Id)">
                            <i class="bi bi-trash"></i> Delete
                        </button>

                        <a asp-action="ExportToPdf" asp-route-id="@q.Id"
                           class="btn btn-sm btn-warning me-3">
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>


@section Scripts {
    <script>
        async function deleteQuotation(id) {
            if (!confirm("Are you sure you want to delete this quotation?")) return;

            const res = await fetch(`/Quotations/Delete/${id}`, { method: "POST" });
            if (res.ok) {
                alert("Quotation deleted successfully.");
                location.reload();
            } else {
                alert("Failed to delete quotation.");
            }
        }
    </script>
}
