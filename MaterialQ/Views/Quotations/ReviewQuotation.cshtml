@{
    ViewData["Title"] = "Review Quotation";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cart3 me-2"></i> Review Quotation</h2>
        <div>
            <button type="button" class="btn btn-danger" onclick="clearCart()">
                <i class="bi bi-trash"></i> Clear Cart
            </button>
            <a asp-controller="Quotations" asp-action="Create" class="btn btn-outline-primary">
                <i class="bi bi-plus-circle"></i> Add More Items
            </a>
        </div>
       
    </div>
  
    <div class="card shadow-sm">
        <div class="card-body">
            <table id="cartTable" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Unit</th>
                        <th>Actual Price</th>
                        <th>Unit Price</th>
                        <th>VAT Amount</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th style="width:60px;">Delete</th>

                    </tr>
                </thead>
                <tbody id="cartBody"></tbody>
            </table>

            <p id="companyError" class="text-danger small" style="display:none;">
                Company name is required
            </p>

            <div class="mb-2 d-flex align-items-center">
                <label class="fw-bold me-2">Company:</label>
                <select id="companyId" class="form-select form-select-sm" style="width: 250px;">
                    <option value="">-- Select Company --</option>
                    @foreach (var c in (List<MaterialQ.Models.DataModels.Company>)ViewBag.Companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex flex-column align-items-end mt-4">
                <div class="mb-2">
                    <label class="fw-bold me-2">Subtotal:</label>
                    <span id="subtotal" class="text-primary fw-bold">0.00</span> AED
                </div>

                <div class="mb-2 d-flex align-items-center">
                    <label class="fw-bold me-2">Discount (%):</label>
                    <input type="number" id="discount"
                           class="form-control form-control-sm w-auto text-center"
                           value="0" min="0" max="100"
                           style="width: 80px;">
                </div>

                <div class="mb-2">
                    <label class="fw-bold me-2">Net Amount:</label>
                    <span id="netAmount" class="text-success fw-bold">0.00</span> AED
                </div>

                <div>
                    <label class="fw-bold me-2">Profit:</label>
                    <span id="profit" class="text-warning fw-bold">0.00</span> AED
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Quotations" asp-action="Create" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>

        <button type="button" class="btn btn-success" onclick="saveQuotation()">
            <i class="bi bi-check-circle"></i> Confirm & Save Quotation
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            loadCart();
            document.getElementById("discount").addEventListener("input", updateNetAmount);
        });

        function loadCart() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            const cartBody = document.getElementById("cartBody");
            const subtotalEl = document.getElementById("subtotal");

            let subtotal = 0;
            let totalCost = 0;

            cartBody.innerHTML = "";

            if (cart.length === 0) {
                cartBody.innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No items added yet.
                        </td>
                    </tr>`;
                subtotalEl.textContent = "0.00";
                document.getElementById("netAmount").textContent = "0.00";
                document.getElementById("profit").textContent = "0.00";
                return;
            }

            cart.forEach(item => {
                const qty = parseFloat(item.qty) || 0;
                const sellingPrice = parseFloat(item.price) || 0;
                const actualPrice = parseFloat(item.actualPrice) || 0;
                const vat = parseFloat(item.vat) || 0;

              
                const vatAmount = (sellingPrice * qty) * 0.05;
                const sellingTotal = (sellingPrice * qty) + vatAmount;
                const costTotal = (actualPrice * qty) + vatAmount;
                subtotal += sellingTotal;
                totalCost += costTotal;

                       const row = `
        <tr>
            <td>${item.code}</td>
            <td>${item.itemDescription}</td>
            <td>${item.unit}</td>
            <td>${actualPrice.toFixed(2)}</td>
            <td>${sellingPrice.toFixed(2)}</td>
            <td>${vatAmount.toFixed(2)}</td>

            <td>
                <input type="number" min="1" value="${qty}"
                    class="form-control form-control-sm text-center qty-input"
                    data-id="${item.id}">
            </td>

            <td class="line-total" data-id="${item.id}">
                ${sellingTotal.toFixed(2)}
            </td>

            <td class="text-center">
                <button class="btn btn-sm btn-outline-danger"
                    onclick="removeItem('${item.id}')">
                    <i class="bi bi-x-lg"></i>
                </button>
            </td>
        </tr>`;

                cartBody.insertAdjacentHTML("beforeend", row);
            });

            subtotalEl.textContent = subtotal.toFixed(2);
            localStorage.setItem("totalCost", totalCost);

            updateNetAmount();

            document.querySelectorAll(".qty-input").forEach(input => {
                input.addEventListener("input", e => {
                    updateQty(e.target.dataset.id, parseFloat(e.target.value));
                });
            });
        }

        function updateQty(id, newQty) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            const item = cart.find(i => i.id == id);

            if (!item) return;

            item.qty = newQty > 0 ? newQty : 1;
            localStorage.setItem("cart", JSON.stringify(cart));

            loadCart();
        }

        function updateNetAmount() {
            const subtotal = parseFloat(document.getElementById("subtotal").textContent) || 0;
            const discountPercent = parseFloat(document.getElementById("discount").value) || 0;

            const discountAmount = subtotal * (discountPercent / 100);
            const net = subtotal - discountAmount;

            document.getElementById("netAmount").textContent = net.toFixed(2);

            const totalCost = parseFloat(localStorage.getItem("totalCost")) || 0;

            // ✅ تعديل الكلفة حسب الخصم
            const adjustedCost = totalCost - (totalCost * (discountPercent / 100));

            const profit = net - adjustedCost;

            document.getElementById("profit").textContent = profit.toFixed(2);
        }

        async function saveQuotation() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if (cart.length === 0) {
                alert("Cart is empty");
                return;
            }

            const companySelect = document.getElementById("companyId");

            if (!companySelect.value) {
                document.getElementById("companyError").style.display = "block";
                return;
            }

            const quotation = {
                companyId: parseInt(companySelect.value),
                discount: parseFloat(document.getElementById("discount").value) || 0,
                totalAmount: parseFloat(document.getElementById("subtotal").textContent) || 0,
                netAmount: parseFloat(document.getElementById("netAmount").textContent) || 0,
                items: cart.map(i => ({
                    itemId: parseInt(i.id),
                    itemDescription: i.itemDescription,
                    quantity: i.qty,
                    unitPrice: parseFloat(i.price),
                    actualPrice: parseFloat(i.actualPrice),
                    vat: parseFloat(i.vat)
                }))
            };

            try {
                const res = await fetch('/Quotations/SaveQuotation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(quotation)
                });

                const data = await res.json();

                if (!data.success) {
                    alert(data.message);
                    return;
                }

                localStorage.removeItem("cart");
                window.location.href = "/Quotations/Index";

            } catch (err) {
                alert("Unexpected error occurred");
                console.error(err);
            }
        }

        function clearCart() {
            if (!confirm("Are you sure you want to clear the cart?")) return;

            localStorage.removeItem("cart");
            localStorage.removeItem("totalCost");

            // إعادة تحميل الجدول وتصفير القيم
            loadCart();
        }
        function removeItem(id) {

            if (!confirm("Remove this item from cart?")) return;

            let cart = JSON.parse(localStorage.getItem("cart")) || [];

            cart = cart.filter(i => i.id != id);

            localStorage.setItem("cart", JSON.stringify(cart));

            loadCart();
        }

    </script>
}

