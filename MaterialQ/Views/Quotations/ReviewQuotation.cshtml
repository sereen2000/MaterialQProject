@{
    ViewData["Title"] = "Review Quotation";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cart3 me-2"></i> Review Quotation</h2>

        <a asp-controller="Quotations" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-circle"></i> Add More Items
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table id="cartTable" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Unit</th>
                        <th>Unit Price</th>
                        <th>VAT</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody id="cartBody"></tbody>
            </table>

            <div class="d-flex flex-column align-items-end mt-4">
                <div class="mb-2">
                    <label class="fw-bold me-2">Subtotal:</label>
                    <span id="subtotal" class="text-primary fw-bold">0.00</span> JOD
                </div>
                <div class="mb-2 d-flex align-items-center">
                    <label class="fw-bold me-2">Discount (%):</label>
                    <input type="number" id="discount" class="form-control form-control-sm w-auto text-center" value="0" min="0" max="100" style="width: 80px;">
                </div>
                <div>
                    <label class="fw-bold me-2">Net Amount:</label>
                    <span id="netAmount" class="text-success fw-bold">0.00</span> JOD
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Quotations" asp-action="Create" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>

        <button type="button" class="btn btn-success" onclick="saveQuotation()">
            <i class="bi bi-check-circle"></i> Confirm & Save Quotation
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            loadCart();

            // إعادة حساب بعد تعديل الخصم
            document.getElementById("discount").addEventListener("input", updateNetAmount);
        });

        function loadCart() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            const cartBody = document.getElementById("cartBody");
            const subtotalEl = document.getElementById("subtotal");
            const netEl = document.getElementById("netAmount");
            let subtotal = 0;
            cartBody.innerHTML = "";

            if (cart.length === 0) {
                cartBody.innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No items added yet.
                        </td>
                    </tr>`;
                subtotalEl.textContent = "0.00";
                netEl.textContent = "0.00";
                return;
            }

            cart.forEach(item => {
                const vat = parseFloat(item.vat || 0);
                const total = (item.price * item.qty) + vat;
                subtotal += total;

                const row = `
                    <tr>
                        <td>${item.code}</td>
                        <td>${item.description}</td>
                        <td>${item.unit}</td>
                        <td>${item.price.toFixed(2)}</td>
                        <td>${vat.toFixed(2)}</td>
                        <td>
                            <input type="number" min="1" value="${item.qty}"
                                class="form-control form-control-sm text-center qty-input"
                                data-id="${item.id}">
                        </td>
                        <td>${total.toFixed(2)}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeFromCart('${item.id}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
                cartBody.insertAdjacentHTML("beforeend", row);
            });

            subtotalEl.textContent = subtotal.toFixed(2);
            updateNetAmount();

            document.querySelectorAll(".qty-input").forEach(input => {
                input.addEventListener("change", e => {
                    updateQty(e.target.dataset.id, parseInt(e.target.value));
                });
            });
        }

        // تحديث الكمية
        function updateQty(id, newQty) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            const item = cart.find(i => i.id == id);
            if (item) {
                item.qty = newQty;
                localStorage.setItem("cart", JSON.stringify(cart));
                loadCart();
            }
        }

        // حذف عنصر من السلة
        function removeFromCart(id) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            cart = cart.filter(i => i.id != id);
            localStorage.setItem("cart", JSON.stringify(cart));
            loadCart();
        }

        // حساب المجموع الصافي بعد الخصم
        function updateNetAmount() {
            const subtotal = parseFloat(document.getElementById("subtotal").textContent) || 0;
            const discountPercent = parseFloat(document.getElementById("discount").value) || 0;
            const discountAmount = subtotal * (discountPercent / 100);
            const net = subtotal - discountAmount;
            document.getElementById("netAmount").textContent = net.toFixed(2);
        }

        // حفظ الكوتيشن فعليًا في قاعدة البيانات
        async function saveQuotation() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if (cart.length === 0) return alert("Cart is empty!");

            const discount = parseFloat(document.getElementById("discount").value) || 0;
            const subtotal = parseFloat(document.getElementById("subtotal").textContent) || 0;
            const net = parseFloat(document.getElementById("netAmount").textContent) || 0;

            const quotation = {
                customerName: "Walk-in Customer",
                discount: discount,
                totalAmount: subtotal,
                netAmount: net,
                items: cart.map(i => ({
                               itemId: parseInt(i.id),
        itemDescription: i.itemDescription,
                            quantity: i.qty,
                            unitPrice: i.price,
                            vat: i.vat
                                    }))
            };

            try {
                const res = await fetch('/Quotations/SaveQuotation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(quotation)
                });

                const data = await res.json();
                if (data.success) {
                    alert("✅ Quotation saved successfully!");
                    localStorage.removeItem("cart");
                    window.location.href = '/Quotations/Index';
                } else {
                    alert("❌ " + (data.message || "Failed to save quotation"));
                }
            } catch (err) {
                console.error(err);
                alert("⚠️ Error saving quotation.");
            }
        }
    </script>
}
