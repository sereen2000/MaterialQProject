@{
    ViewData["Title"] = "Review Quotation";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cart3 me-2"></i> Review Quotation</h2>

        <a asp-controller="Quotations" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-circle"></i> Add More Items
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table id="cartTable" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Unit</th>
                        <th>Unit Price</th>
                        <th>VAT</th>
                        <th>Quantity</th>
                        <th>Color</th>
                        <th>Discount (%)</th>
                        <th>Total</th>
                        <th style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody id="cartBody"></tbody>
            </table>
            <p id="companyError" class="text-danger small" style="display:none;">
                Company name is required
            </p>
            <div class="mb-2 d-flex align-items-center">
                <label class="fw-bold me-2">Company Name:</label>
                <input type="text" id="companyName" class="form-control form-control-sm"
                       placeholder="Enter company name"
                       style="width: 250px;">
            </div>

            <div class="d-flex flex-column align-items-end mt-4">
                <div class="mb-2">
                    <label class="fw-bold me-2">Subtotal:</label>
                    <span id="subtotal" class="text-primary fw-bold">0.00</span> JOD
                </div>
                <div class="mb-2 d-flex align-items-center">
                    <label class="fw-bold me-2">Discount (%):</label>
                    <input type="number" id="discount" class="form-control form-control-sm w-auto text-center" value="0" min="0" max="100" style="width: 80px;">
                </div>
                <div>
                    <label class="fw-bold me-2">Net Amount:</label>
                    <span id="netAmount" class="text-success fw-bold">0.00</span> JOD
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Quotations" asp-action="Create" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>

        <button type="button" class="btn btn-success" onclick="saveQuotation()">
            <i class="bi bi-check-circle"></i> Confirm & Save Quotation
        </button>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            loadCart();

            document.getElementById("discount").addEventListener("input", updateNetAmount);
        });

        function loadCart() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            const cartBody = document.getElementById("cartBody");
            const subtotalEl = document.getElementById("subtotal");
            const netEl = document.getElementById("netAmount");

            let subtotal = 0;
            cartBody.innerHTML = "";
       

            if (cart.length === 0) {
                cartBody.innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No items added yet.
                        </td>
                    </tr>`;
                subtotalEl.textContent = "0.00";
                netEl.textContent = "0.00";
                return;
            }

            cart.forEach(item => {
                const vat = parseFloat(item.vat || 0);
                       const discount = parseFloat(item.discount || 0);
        const lineTotal = (item.price * item.qty) - discount + vat;

        subtotal += lineTotal;

            item.discount = parseFloat(item.discount) || 0;
        const row = `
        <tr>
            <td>${item.code}</td>
            <td>${item.itemDescription}</td>
            <td>${item.unit}</td>
            <td>${item.price.toFixed(2)}</td>
            <td>${vat.toFixed(2)}</td>

            <td>
                 <input type="number" min="1" value="${item.qty}"
                    class="form-control form-control-sm text-center qty-input"
                    data-id="${item.id}"
                    data-colorid="${item.colorId}">

            </td>

            <td>
                <span class="badge bg-dark">${item.colorName}</span>
            </td>

            <td>
                  <input type="number" min="0" value="${discount}"
                        class="form-control form-control-sm text-center discount-input"
                        data-id="${item.id}"
                        data-colorid="${item.colorId}"
                        style="width:80px">

            </td>

                    <td class="line-total"
            data-id="${item.id}"
            data-colorid="${item.colorId}">
          ${lineTotal.toFixed(2)}
        </td>


            <td class="text-end">
                <button type="button" class="btn btn-sm btn-danger"
                        onclick="removeFromCart('${item.id}', '${item.colorId}')">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        </tr>`;

                cartBody.insertAdjacentHTML("beforeend", row);
            });

            subtotalEl.textContent = subtotal.toFixed(2);
            updateNetAmount();


            document.querySelectorAll(".qty-input").forEach(input => {
            input.addEventListener("input", e => {
                updateQty(e.target.dataset.id, parseFloat(e.target.value), e.target.dataset.colorid);
            });
        });

                document.querySelectorAll(".discount-input").forEach(input => {
            input.addEventListener("input", e => {
                updateDiscount(
                    e.target.dataset.id,
                    parseFloat(e.target.value),
                    e.target.dataset.colorid
                );
            });
      

        });

        

        }
                      function updateDiscount(id, discount, colorId) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            const item = cart.find(i => i.id == id && i.colorId == colorId);

            if (!item) return;

            item.discount = discount >= 0 ? discount : 0;
            localStorage.setItem("cart", JSON.stringify(cart));

            updateLineTotal(item); // ✅ تحديث Total السطر
            recalcTotals();        // ✅ تحديث Subtotal
        }

        function updateQty(id, newQty, colorId) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            const item = cart.find(i => i.id == id && i.colorId == colorId);

            if (!item) return;

            if (newQty > item.availableQty) {
                alert(`Only ${item.availableQty} units are available for color "${item.colorName}".`);
                return;
            }

            item.qty = newQty > 0 ? newQty : 1;
            localStorage.setItem("cart", JSON.stringify(cart));

            updateLineTotal(item); // ✅ تحديث Total السطر
            recalcTotals();        // ✅ تحديث Subtotal
        }


                    function recalcTotals() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            let subtotal = 0;

            cart.forEach(item => {
                subtotal += updateLineTotal(item);
            });

            document.getElementById("subtotal").textContent = subtotal.toFixed(2);
            updateNetAmount();
        }

        function removeFromCart(id, colorId) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            cart = cart.filter(i => !(i.id == id && i.colorId == colorId));
            localStorage.setItem("cart", JSON.stringify(cart));
            loadCart();
        }

                      function updateLineTotal(item) {
            const price = parseFloat(item.price) || 0;
            const qty = parseFloat(item.qty) || 0;
            const discount = parseFloat(item.discount) || 0; // ⭐ الحل
            const vat = parseFloat(item.vat) || 0;

            const base = price * qty;
            const discountAmount = base * (discount / 100);
            const lineTotal = base - discountAmount + vat;

            const cell = document.querySelector(
                `.line-total[data-id="${item.id}"][data-colorid="${item.colorId}"]`
            );

            if (cell) {
                cell.textContent = lineTotal.toFixed(2);
            }

            return lineTotal;
        }
                function hasSellingPriceHigherThanOriginal() {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];

            for (let item of cart) {
                const price = parseFloat(item.price) || 0;
                const qty = parseFloat(item.qty) || 0;
                const vat = parseFloat(item.vat) || 0;
                const discount = parseFloat(item.discount) || 0;

                const originalTotal = (price * qty) + vat;

                const base = price * qty;
                const discountAmount = base * (discount / 100);
                const sellingTotal = base - discountAmount + vat;

                if (sellingTotal < originalTotal) {
                    return {
                        hasIssue: true,
                        itemName: item.itemDescription,
                        originalTotal,
                        sellingTotal
                    };
                }
            }

            return { hasIssue: false };
        }


        function updateNetAmount() {
            const subtotal = parseFloat(document.getElementById("subtotal").textContent) || 0;
            const discountPercent = parseFloat(document.getElementById("discount").value) || 0;
            const discountAmount = subtotal * (discountPercent / 100);
            const net = subtotal - discountAmount;
            document.getElementById("netAmount").textContent = net.toFixed(2);
        }
                function clearError() {
            document.getElementById("companyError").style.display = "none";
        }

              async function saveQuotation() {

            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if (cart.length === 0) {
                alert("Cart is empty");
                return;
            }

            const quotation = {
                customerName: document.getElementById("companyName").value,
                discount: parseFloat(document.getElementById("discount").value) || 0,
                totalAmount: parseFloat(document.getElementById("subtotal").textContent) || 0,
                netAmount: parseFloat(document.getElementById("netAmount").textContent) || 0,
                items: cart.map(i => ({
                    itemId: i.id,
                    colorId: i.colorId,
                    itemDescription: i.itemDescription,
                    quantity: i.qty,
                    unitPrice: i.price,
                    vat: i.vat,
                    discount: i.discount || 0
                }))
            };
                    const priceCheck = hasSellingPriceHigherThanOriginal();

        if (priceCheck.hasIssue) {
            const confirmResult = confirm(
                `⚠️ Warning!\n\n` +
                `The selling total for item:\n"${priceCheck.itemName}"\n\n` +
                `Selling Total: ${priceCheck.sellingTotal.toFixed(2)} JOD\n` +
                `Original Total: ${priceCheck.originalTotal.toFixed(2)} JOD\n\n` +
                `Selling price is higher than the original price.\n\n` +
                `Do you want to continue anyway?`
            );

            if (!confirmResult) {
                return; // ❌ أوقف الحفظ
            }
        }

            try {
                const res = await fetch('/Quotations/SaveQuotation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(quotation)
                });

                const data = await res.json();

                // ❌ Error → stay on page
                if (!data.success) {
                    alert(data.message);
                    return;
                }

                // ✅ Success
                // alert("Quotation saved successfully");
                localStorage.removeItem("cart");
                window.location.href = "/Quotations/Index";

            } catch (err) {
                alert("Unexpected error occurred");
                console.error(err);
            }
        }

    </script>
}
