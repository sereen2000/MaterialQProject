
@{
    ViewData["Title"] = "Quotation Cart";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cart3 me-2"></i> Review Quotation</h2>
        <a asp-controller="Main" asp-action="AddQuotation" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>

    <form>
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-bordered align-middle" id="quotationTable">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Color</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>Rate %</th>
                            <th>VAT %</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Product 1</td>
                            <td>
                                <select class="form-select">
                                    <option>Red</option>
                                    <option>Blue</option>
                                </select>
                            </td>
                            <td><input type="number" class="form-control" value="12.50" step="0.01" /></td>
                            <td><input type="number" class="form-control" value="1" min="1" /></td>
                            <td><input type="text" class="form-control" value="Piece" readonly /></td>
                            <td><input type="number" class="form-control" value="0" /></td>
                            <td><input type="number" class="form-control" value="16" /></td>
                            <td><input type="text" class="form-control" value="14.50" readonly /></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- الإجمالي -->
        <div class="card mt-4 shadow-sm" style="max-width:400px; margin-left:auto;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <span>Subtotal:</span>
                    <strong>12.50</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>VAT:</span>
                    <strong>2.00</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Total:</span>
                    <strong>14.50</strong>
                </div>
            </div>
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-success px-4">
                <i class="bi bi-check-circle"></i> Save Quotation
            </button>
        </div>
    </form>
</div>


