@model MaterialQ.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="pagetitle mb-4">
    <h1>Quotation Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Main" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div>
@* 

<!-- LOW STOCK ALERT --> *@
@if (Model.LowStockItems != null && Model.LowStockItems.Any())
{
    <div class="alert alert-warning shadow-sm border-warning" style="border-left:5px solid #ff9900;">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:1.4rem; color:#cc6600;"></i>
            <h5 class="ms-2 mb-0" style="color:#cc6600;">Low Stock Alert</h5>
        </div>

        <p class="mb-2">Some items are running low on stock:</p>

        <ul class="list-group">
            @foreach (var item in Model.LowStockItems)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@item.Code</strong>
                        <span class="text-muted">| @item.ColorName</span>
                    </div>

                    <span class="badge bg-danger rounded-pill">@item.Qty left</span>
                </li>
            }
        </ul>
    </div>
}

<section class="section dashboard">
    <div class="row">
        <div class="row">

            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 text-center">
                    <h6 class="text-muted mb-1">Total Quotations</h6>
                    <h4 class="fw-bold">@ViewBag.TotalCount</h4>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 text-center">
                    <h6 class="text-muted mb-1">Total Items</h6>
                    <h4 class="fw-bold">@ViewBag.ItemsCount</h4>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 text-center">
                    <h6 class="text-muted mb-1">Users</h6>
                    <h4 class="fw-bold">@ViewBag.UsersCount</h4>
                </div>
            </div>

        </div>

        <!-- Recent Quotations -->
        <div class="col-12 mt-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title mb-3">Recent Quotations</h5>

                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Quotation Number</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Net Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.Recent != null && ((IEnumerable<dynamic>)ViewBag.Recent).Any())
                            {
                                foreach (var q in ViewBag.Recent)
                                {
                                    <tr>
                                        <td>@q.Id</td>
                                        <td>@q.QuotationNumber</td>
                                        <td>@q.Company.Name</td>
                                        <td>@q.DateCreated.ToString("yyyy-MM-dd")</td>
                                        
                                        <td>@String.Format("{0:N2}", q.TotalAmount)</td>
                                        <td>@String.Format("{0:N2}", q.NetAmount)</td>
                                        <td>
                                            <a asp-controller="Quotations" asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        No quotations found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

    </div>
</section>
