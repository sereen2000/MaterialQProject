@{
    ViewData["Title"] = "Add Quotation";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-plus-circle me-2"></i> Select Products</h2>

        <a asp-controller="Main" asp-action="ReviewQuotation" class="btn btn-outline-secondary position-relative">
            <i class="bi bi-cart3"></i> Cart
            <span id="cartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
        </a>
    </div>

    <!-- فلاتر -->
    <form class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Search products..." />
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>All Categories</option>
                <option>Electronics</option>
                <option>Furniture</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select">
                <option>All Brands</option>
                <option>Brand A</option>
                <option>Brand B</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-primary"><i class="bi bi-search"></i> Filter</button>
        </div>
    </form>

    <!-- جدول المنتجات -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Unit</th>
                        <th style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>P-001</td>
                        <td>Product 1</td>
                        <td>12.50</td>
                        <td>Piece</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-success"><i class="bi bi-plus-circle"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>P-002</td>
                        <td>Product 2</td>
                        <td>20.00</td>
                        <td>Box</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-success"><i class="bi bi-plus-circle"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
