@{
    ViewData["Title"] = "Quotations";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-receipt me-2"></i> Quotations</h2>
        <a asp-controller="Main" asp-action="AddQuotation" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Quotation
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Placeholder عند عدم وجود بيانات -->
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            No quotations found.<br />
                            <a asp-controller="Main" asp-action="AddQuotation" class="btn btn-sm btn-outline-primary mt-3">
                                <i class="bi bi-plus-circle"></i> Create your first quotation
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
