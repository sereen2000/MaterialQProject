@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model MaterialQ.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<section class="section">

    <!-- Welcome -->
    <div class="mb-4">
        <h3 class="fw-bold">
            Welcome back 👋
        </h3>
        <p class="text-muted mb-0">
            Manage quotations and items from one place.
        </p>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-5">

        <!-- Create RFQ -->
        <div class="col-md-6 mb-3">
            <a asp-controller="RFQ" asp-action="Create"
               class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body">
                    <i class="bi bi-file-earmark-plus fs-2 text-primary"></i>
                    <h5 class="mt-3 text-dark">Create a Request for Quotation </h5>
                    <p class="text-muted mb-0">
                        Start a new quotation request for a customer as Pdf
                    </p>
                </div>
            </a>
        </div>

        <!-- Items -->
        <div class="col-md-6 mb-3">
            <a asp-controller="Item" asp-action="Index"
               class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body">
                    <i class="bi bi-box-seam fs-2 text-success"></i>
                    <h5 class="mt-3 text-dark">Items</h5>
                    <p class="text-muted mb-0">
                        Manage products, units, and quantities.
                    </p>
                </div>
            </a>
        </div>

    </div>

</section>
<div class="col-12 mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Recent Quotations</h5>

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Quotation Number</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Net Amount</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Recent != null && ((IEnumerable<dynamic>)ViewBag.Recent).Any())
                    {
                        foreach (var q in ViewBag.Recent)
                        {
                            <tr>
                                <td>@q.Id</td>
                                <td>@q.QuotationNumber</td>
                                <td>@q.CustomerName</td>
                                <td>@q.DateCreated.ToString("yyyy-MM-dd")</td>

                                <td>@String.Format("{0:N2}", q.TotalAmount)</td>
                                <td>@String.Format("{0:N2}", q.NetAmount)</td>
                                <td>
                                    <a asp-controller="Quotations" asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No quotations found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
