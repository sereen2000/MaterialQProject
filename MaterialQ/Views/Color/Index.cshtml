@model IEnumerable<MaterialQ.Models.DataModels.ColorsModel>

@{
    ViewData["Title"] = "Color Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Colors</a></li>
            <li class="breadcrumb-item active">Data Table</li>
        </ol>
    </nav>
</div>
<!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">

                    <a class="btn btn-primary mb-3" id="addColorBtn"> 
                        <i class="ri-add-circle-fill"></i>Add Color
                    </a>
                    </div>
                    <!-- Table with stripped rows -->
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Color Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                             @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No items found.</td>
                                </tr>
                            }
                            else
                            {
                            @foreach (var color in Model)
                            {
                                <tr>
                                    <td>@color.Id</td>
                                    <td>@color.Name</td>
                                    <td>
                                            <button class="btn btn-sm btn-outline-primary editColorBtn" data-id="@color.Id">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger deleteColorBtn" data-id="@color.Id">Delete</button>

                                    </td>
                                </tr>
                            }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</section>
<div id="modalContainer"></div>

@section Scripts {
    <script>
                const modalContainer = document.getElementById('modalContainer');

        // Add Color
        document.getElementById('addColorBtn').addEventListener('click', async () => {
            const res = await fetch('/Color/CreateColor');
            const html = await res.text();
            modalContainer.innerHTML = html;
            const modalEl = modalContainer.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        });

        // Edit Color
        document.querySelectorAll('.editColorBtn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const res = await fetch(`/Color/EditColor?id=${id}`);
                const html = await res.text();
                modalContainer.innerHTML = html;
                const modalEl = modalContainer.querySelector('.modal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });

        // Delete Color
        document.querySelectorAll('.deleteColorBtn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const res = await fetch(`/Color/DeleteColor?id=${id}`);
                const html = await res.text();
                modalContainer.innerHTML = html;
                const modalEl = modalContainer.querySelector('.modal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });
        function deleteColor(id) {
            $.post("/Color/DeleteColorConfirmed", { id: id }, function (res) {
                if (res.success) {
                    
                    $('#deleteSuccessModal').modal('show');

                    setTimeout(() => {
                        location.reload();
                    }, 1500);

                } else {
                  
                    $('#deleteErrorModal .modal-body').text(res.message);
                    $('#deleteErrorModal').modal('show');
                }
            });
        }

       


    </script>
}

