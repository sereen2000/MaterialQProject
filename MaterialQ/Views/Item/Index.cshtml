@model IEnumerable<MaterialQ.Models.ViewModels.RetrieveItemViewModel>
@{
    ViewData["Title"] = "Items Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Item" asp-action="Index">Items</a></li>
            <li class="breadcrumb-item active">Data Table</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Items Data Tables</h5>
                        <a type="button" class="btn btn-primary" href="@Url.Action("Create", "Item")">
                            <i class="ri-add-circle-fill"></i> New Item
                        </a>
                    </div>

                    <table class="table datatable align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Item Image</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Total Qty</th>
                                <th>Colors</th>
                                <th>Unit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No items found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>

                                        <td>
                                            @if (item.ImageFile == null)
                                            {
                                                <i class="bi bi-image text-muted" style="font-size:24px;"></i>
                                            }
                                            else
                                            {
                                                <img src="@Url.Content(item.ImageFile.ToString())"
                                                     class="rounded-circle"
                                                     style="width:45px; height:45px; object-fit:cover;">
                                            }
                                        </td>

                                        <td>@item.Code</td>
                                        <td>@item.Description</td>
                                        <td>@item.Price</td>

                                        <!-- Show summed quantity -->
                                        <td>@item.TotalQty</td>

                                        <td>
                                            @for (int i = 0; i < item.Colors.Count; i++)
                                            {
                                                <span class="badge bg-secondary me-1 mb-1">
                                                    @item.Colors[i].ColorName (@item.Colors[i].Quantity)
                                                </span>

                                                @* Add a line break after every 2 spans *@
                                                @if ((i + 1) % 2 == 0)
                                                {
                                                    <br />
                                                }
                                            }
                                        </td>

                                        <td>@item.UnitName</td>

                                        <td>
                                            <a href="@Url.Action("Edit", "Item", new { id = item.Id })"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <button type="button" class="btn btn-sm btn-outline-danger deleteBtn" 
                                            data-id="@item.Id">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>

                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll(".deleteBtn").forEach(btn => {
            btn.addEventListener("click", async function () {
                const id = this.dataset.id;

                const response = await fetch(`/Item/_DeleteItemModal?id=${id}`);
                const html = await response.text();

                const tempDiv = document.createElement("div");
                tempDiv.innerHTML = html;
                document.body.appendChild(tempDiv);

                const modalEl = tempDiv.querySelector(".modal");
                const modal = new bootstrap.Modal(modalEl);
                modal.show();

                modalEl.addEventListener('hidden.bs.modal', () => tempDiv.remove());
            });
        });
    </script>
}

