@model IEnumerable<MaterialQ.Models.DataModels.ItemsModel>
@{
    ViewData["Title"] = "Items Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Item" asp-action="Index">Items</a></li>
            <li class="breadcrumb-item active">Data</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Items Data Tables</h5>
                        <a type="button" class="btn btn-primary" href="@Url.Action("Create", "Item")">
                            <i class="ri-add-circle-fill"></i> New Item
                        </a>
                    </div>

                    <!-- Table with stripped rows -->
                    <table class="table datatable align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Item Image</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Color</th>
                                <th>Unit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No items found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(item.Image))
                                            {
                                                <i class="bi bi-image text-muted" style="font-size:24px;"></i>
                                            }
                                            else
                                            {
                                                <img src="@Url.Content(item.Image)" alt="Item Image" class="rounded-circle" style="width:45px;height:45px;object-fit:cover;">
                                            }
                                        </td>
                                        <td>@item.Code</td>
                                        <td>@item.Description</td>
                                        <td>@item.Price</td>
                                        <td>@item.Qty</td>
                                        <td>@item.Color?.Name</td>
                                        <td>@item.Unit?.Name</td>
                                        <td>
                                            <a href="@Url.Action("Edit", "Item", new { id = item.Id })"
                                                class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <a href="@Url.Action("DeleteItem", "Item", new { id = item.Id })"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Are you sure you want to delete this item?');">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>
            </div>

        </div>
    </div>
</section>

