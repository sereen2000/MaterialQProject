@model IEnumerable<MaterialQ.Models.DataModels.ItemsModel>
@{
    ViewData["Title"] = "Items Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Item" asp-action="Index">Items</a></li>
            <li class="breadcrumb-item active">Data</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Items Data Tables</h5>

                    <!-- Table with stripped rows -->
                    <table class="table datatable align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Item Image</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Color</th>
                                <th>Unit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No items found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            <img src="~/img/profile-img.jpg"
                                                 alt="Item Image"
                                                 class="rounded-circle"
                                                 style="width:45px;height:45px;object-fit:cover;">
                                        </td>
                                        <td>@item.Code</td>
                                        <td>@item.Description</td>
                                        <td>@item.Price</td>
                                        <td>@item.Qty</td>
                                        <td>@item.Color?.Name</td>
                                        <td>@item.Unit?.Name</td>
                                        <td>
                                            <a href="@Url.Action("Edit", "Item", new { id = item.Id })"
                                               class="btn btn-sm btn-primary me-1">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <a href="@Url.Action("DeleteItem", "Item", new { id = item.Id })"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this item?');">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>
            </div>

        </div>
    </div>
</section>

