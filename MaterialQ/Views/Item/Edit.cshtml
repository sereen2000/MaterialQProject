@model MaterialQ.Models.ViewModels.UpdateItemViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Edit Item";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Home</a></li>
            <li class="breadcrumb-item">Items</li>
            <li class="breadcrumb-item active">Edit Item</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Edit Item</h5>

                <form id="editItemForm" method="post" enctype="multipart/form-data">


                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Item Image</label>
                        <div class="col-sm-10">
                            @if (!string.IsNullOrEmpty(Model.ExistingImage))
                            {
                                <img src="@Model.ExistingImage" width="100" class="mb-2" />
                            }
                            <input class="form-control" type="file" name="ImageFile">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Item Name</label>
                        <div class="col-sm-10">
                            <input asp-for="Code" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Description</label>
                        <div class="col-sm-10">
                            <input asp-for="Description" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Price</label>
                        <div class="col-sm-10">
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Actual Price</label>
                        <div class="col-sm-10">
                            <input asp-for="ActualPrice" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">VAT</label>
                        <div class="col-sm-10">
                            <input asp-for="Vat" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>

                    <!-- كمية عامة -->
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Quantity</label>
                        <div class="col-sm-10">
                            <input asp-for="Qty" type="number" min="0" class="form-control" />
                        </div>
                    </div>

                    <!-- Unit -->
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Unit</label>
                        <div class="col-sm-10">
                            <select asp-for="UnitId" class="form-select" asp-items="@(new SelectList(ViewBag.Units, "Id", "Name"))">
                            </select>
                        </div>
                    </div>


                    <hr />
                    <button type="submit" class="btn btn-primary">Update Item</button>
                </form>
            </div>
        </div>
    </div>
</div>
