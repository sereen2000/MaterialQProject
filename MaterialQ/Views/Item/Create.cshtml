@{
    ViewData["Title"] = "Items Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item">Items</li>
            <li class="breadcrumb-item active">Create Item</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">New Item</h5>

                <!-- Form -->
                <form asp-action="Create" method="post" enctype="multipart/form-data">

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Item Image</label>
                        <div class="col-sm-10">
                            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Item Name</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" name="Code" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Description</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" name="Description" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Price</label>
                        <div class="col-sm-10">
                            <input type="number" class="form-control" name="Price" step="0.01" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Actual Price</label>
                        <div class="col-sm-10">
                            <input type="number" class="form-control" name="ActualPrice" step="0.01" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">VAT</label>
                        <div class="col-sm-10">
                            <input type="text"
                                   class="form-control"
                                   value="5%"
                                   readonly>
                            <input type="hidden" name="Vat" value="0.05" />
                        </div>
                    </div>


                    <!-- ✅ الكمية بدل الألوان -->
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Quantity</label>
                        <div class="col-sm-10">
                            <input type="number" class="form-control" name="Qty" min="0" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Unit</label>
                        <div class="col-sm-10">
                            <select class="form-select" name="UnitId" required>
                                <option selected disabled>Select unit</option>
                                @foreach (var unit in ViewBag.Units)
                                {
                                    <option value="@unit.Id">@unit.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const colorSelect = document.getElementById("colorSelect");
        const newColorDiv = document.getElementById("newColorDiv");
        const newColorInput = document.getElementById("newColorInput");
        const colorQty = document.getElementById("newColorQty");
        const saveColorBtn = document.getElementById("saveColorBtn");
        const colorTableBody = document.querySelector("#colorTable tbody");
        const colorModal = new bootstrap.Modal(document.getElementById("colorModal"));
        const colorsJsonInput = document.getElementById("ColorsJson");

        let colorsList = [];

        // Show/hide new color input
        colorSelect.addEventListener("change", function () {
            if (this.value === "addNew") {
                newColorDiv.style.display = "block";
                newColorInput.value = "";
                newColorInput.focus();
            } else {
                newColorDiv.style.display = "none";
            }
        });

        // Add color to table & array
        saveColorBtn.addEventListener("click", function () {
            let colorId = colorSelect.value;
            let colorName = colorSelect.options[colorSelect.selectedIndex].text;

            if (colorId === "addNew") {
                colorName = newColorInput.value.trim();
                colorId = 0; // New color, backend will handle
            }

            const qty = parseInt(colorQty.value.trim());
            if (!colorName || !qty || qty <= 0) {
                alert("Please select a color and enter a valid quantity");
                return;
            }

            // Add row to table
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${colorName}</td>
                <td>${qty}</td>
                <td><button type="button" class="btn btn-danger btn-sm deleteRow">🗑️</button></td>
            `;
            colorTableBody.appendChild(row);

            // Add to array
            colorsList.push({ ColorId: parseInt(colorId), ColorName: colorName, Quantity: qty });
            colorsJsonInput.value = JSON.stringify(colorsList);

            // Delete row
            row.querySelector(".deleteRow").addEventListener("click", function () {
                const index = Array.from(colorTableBody.children).indexOf(row);
                colorsList.splice(index, 1);
                colorsJsonInput.value = JSON.stringify(colorsList);
                row.remove();
            });

            // Reset modal
            colorSelect.selectedIndex = 0;
            newColorDiv.style.display = "none";
            newColorInput.value = "";
            colorQty.value = "";
            colorModal.hide();
        });

        // Ensure ColorsJson is updated before submit
        const form = document.querySelector("form");
        form.addEventListener("submit", function () {
            colorsJsonInput.value = JSON.stringify(colorsList);
        });

        // ==== UNIT MODAL FUNCTIONALITY ====
        const unitModal = new bootstrap.Modal(document.getElementById("unitModal"));
        const newUnitInput = document.getElementById("newUnitInput");
        const saveUnitBtn = document.getElementById("saveUnitBtn");
        const newUnitHidden = document.getElementById("NewUnitName");

        // When "Add New" is selected — open the modal
        unitSelect.addEventListener("change", function () {
            if (this.value === "addUnit") {
                newUnitInput.value = "";
                unitModal.show();
                this.selectedIndex = 0; // reset to "Select item unit"
            }
        });

        // Save new unit and add it to the dropdown
        saveUnitBtn.addEventListener("click", function () {
            const unitName = newUnitInput.value.trim();
            if (!unitName) {
                alert("Please enter a unit name");
                return;
            }

            // Create new <option> with ID = 0
            const newOption = document.createElement("option");
            newOption.value = 0; // backend سيضيفه بعدين
            newOption.textContent = unitName;

            // Insert before "Add Unit"
            const addUnitOption = unitSelect.querySelector("option[value='addUnit']");
            unitSelect.insertBefore(newOption, addUnitOption);

            // Select the new unit
            unitSelect.value = 0;

            // Put name in hidden input for backend
            newUnitHidden.value = unitName;

            unitModal.hide();
        });
    </script>
}

