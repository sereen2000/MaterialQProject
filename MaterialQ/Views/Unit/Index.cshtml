@model IEnumerable<MaterialQ.Models.DataModels.UnitModel>

@{
    ViewData["Title"] = "Units Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}
<div class="pagetitle">
    <h1>Data Tables</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Unit" asp-action="Index">Units</a></li>
            <li class="breadcrumb-item active">Data</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                        <h5 class="card-title mb-0">Items Data Tables</h5>

                        <button class="btn btn-primary mb-3" id="addUnitBtn"> 
                            <i class="ri-add-circle-fill"></i>Add Unit
                        </button>
                    </div>

                    <table class="table datatable align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Unit Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unit in Model)
                            {
                                <tr>
                                    <td>@unit.Id</td>
                                    <td>@unit.Name</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary editUnitBtn" data-id="@unit.Id">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger deleteUnitBtn" data-id="@unit.Id">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>
    </div>
</section>
<div id="modalContainer"></div>

@section Scripts {
    <script>
        const modalContainer = document.getElementById('modalContainer');

        // Add Unit
        document.getElementById('addUnitBtn').addEventListener('click', async () => {
            const res = await fetch('/Unit/CreateUnit');
            const html = await res.text();
            modalContainer.innerHTML = html;
            const modalEl = modalContainer.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        });

        // Edit Unit
        document.querySelectorAll('.editUnitBtn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const res = await fetch(`/Unit/EditUnit?id=${id}`);
                const html = await res.text();
                modalContainer.innerHTML = html;
                const modalEl = modalContainer.querySelector('.modal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });

        // Delete Unit
        document.querySelectorAll('.deleteUnitBtn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const res = await fetch(`/Unit/DeleteUnit?id=${id}`);
                const html = await res.text();
                modalContainer.innerHTML = html;
                const modalEl = modalContainer.querySelector('.modal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });
    </script>
}
