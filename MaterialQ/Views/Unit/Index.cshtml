@model IEnumerable<MaterialQ.Models.DataModels.UnitModel>

@{
    ViewData["Title"] = "Units Data Table";
    Layout = "~/Views/Shared/LayoutMain.cshtml";

}
<div class="pagetitle">
    <h1>Data Tables</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Units</a></li>
            <li class="breadcrumb-item active">Data</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Unit Data Tables</h5>
                        <a type="button" class="btn btn-primary" href="@Url.Action("Create", "Unit")">
                            <i class="ri-add-circle-fill"></i> New Item
                        </a>
                    </div>
                    <!-- Table with stripped rows -->
                    <table class="table datatable">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Unit Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">No items found.</td>
                                </tr>
                            }
                                else
                                {
                                    @foreach (var unit in Model)
                                    {
                                        <tr>
                                            <td>@unit.Id</td>
                                            <td>@unit.Name</td>
                                            <td>
                                            <a href="@Url.Action("Edit", "Unit", new { id = unit.Id })"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>

                                            <a href="@Url.Action("Delete", "Unit", new { id = unit.Id })"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                            </td>
                                        </tr>
                                    }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </section>